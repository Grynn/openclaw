# Source installs require pinned pnpm; its settings are in pnpm-workspace.yaml.
# npm tooling needs npm 11.19+ for install/pack cooldowns and exclusions.
# Node 22's bundled npm 10 does not enforce these settings.
# npm expresses release age in days; pnpm uses minutes.
min-release-age=7
# Trusted Codex runtimes are outside the dependency cooldown.
min-release-age-exclude[]=@openai/codex
min-release-age-exclude[]=@openai/codex-*
# Reviewed fs-safe 0.21.2 release and native helpers; remove after 2026-10-05T17:19:08.397Z.
# npm 11.19 matches exclusions by package name only; the production manifests pin 0.21.2.
min-release-age-exclude[]=@openclaw/fs-safe
min-release-age-exclude[]=@openclaw/fs-safe-darwin-arm64
min-release-age-exclude[]=@openclaw/fs-safe-darwin-x64
min-release-age-exclude[]=@openclaw/fs-safe-linux-arm64-gnu
min-release-age-exclude[]=@openclaw/fs-safe-linux-arm64-musl
min-release-age-exclude[]=@openclaw/fs-safe-linux-x64-gnu
min-release-age-exclude[]=@openclaw/fs-safe-linux-x64-musl
min-release-age-exclude[]=@openclaw/fs-safe-win32-x64-msvc
